{
	admin 127.0.0.1:2021
	persist_config off
}

http://:8080 {
	bind 127.0.0.1

	@tunnel {
		host {$WEBCHAT_CADDY_HOST:chat.example.com}
		header CF-Connecting-IP *
		header !CF-Worker
		header X-Forwarded-Proto https
	}
	handle @tunnel {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-Proto https
			header_up -X-Real-IP
		}
	}
	handle {
		respond "Access denied" 403
	}
}
