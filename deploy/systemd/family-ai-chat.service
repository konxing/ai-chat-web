[Unit]
Description=Family AI Chat (Next.js custom server)
Documentation=file:///srv/family-ai-chat/README.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=familyai
Group=familyai
WorkingDirectory=/srv/family-ai-chat
EnvironmentFile=/srv/family-ai-chat/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=65535

# Hardening (adjust paths if you install elsewhere).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/srv/family-ai-chat/uploads /srv/family-ai-chat/backups /srv/family-ai-chat/.next/cache

StandardOutput=journal
StandardError=journal
SyslogIdentifier=family-ai-chat

[Install]
WantedBy=multi-user.target
