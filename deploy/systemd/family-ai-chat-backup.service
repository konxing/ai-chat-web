[Unit]
Description=Encrypted Family AI Chat backup
Documentation=file:///srv/family-ai-chat/docs/BACKUP_RESTORE.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=familyai
Group=familyai
WorkingDirectory=/srv/family-ai-chat
EnvironmentFile=/srv/family-ai-chat/.env
ExecStart=/usr/bin/node scripts/backup.mjs
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/family-ai-chat/backups
