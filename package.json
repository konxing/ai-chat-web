{
  "name": "family-ai-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Private, self-hosted AI chat for a family, with IP allowlisting, per-user isolation and encrypted storage.",
  "scripts": {
    "dev": "node server.js --dev",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production node server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "sync:nginx": "tsx scripts/sync-nginx-allowlist.ts",
    "sync:firewall": "tsx scripts/sync-firewall.ts",
    "rotate-keys": "tsx scripts/rotate-keys.ts",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "bash tests/run-integration.sh",
    "test:all": "bash tests/run-all.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.11.1",
    "argon2": "0.44.0",
    "dotenv": "16.6.1",
    "file-type": "19.6.0",
    "ipaddr.js": "2.2.0",
    "katex": "0.16.22",
    "lucide-react": "0.468.0",
    "mammoth": "1.10.0",
    "next": "^15.5.28",
    "nodemailer": "6.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "undici": "6.21.0",
    "unpdf": "1.2.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.4",
    "prisma": "6.11.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
