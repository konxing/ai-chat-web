generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProviderOwner {
  GLOBAL
  USER
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum MessageStatus {
  COMPLETE
  PARTIAL
  ERROR
}

enum AttachmentKind {
  IMAGE
  FILE
  AUDIO
}

enum EmailTokenPurpose {
  REGISTER
  RESET
  EMAIL_CHANGE
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum EmotionTransparency {
  OFF
  IMPLICIT
  EXPLICIT
}

/// 任务书 1.2 的七种交互情境。每个用户每种情境一行策略。
enum MemoryContext {
  GENERAL
  TECHNICAL_PROJECT
  LEARNING
  PERSONAL_GOAL
  PERSONAL_REFLECTION
  EMOTIONAL_SUPPORT
  DECISION_MAKING
}

enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  PROJECT
  DECISION
  EMOTION
}

enum MemoryRetention {
  FOREVER
  UNTIL_SUPERSEDED
  DAYS_30
  DAYS_90
  SESSION_ONLY
}

/// 一条记忆的认识论地位（任务书 2.2）。推断和假设永远不等于用户说过或确认过。
enum MemoryOrigin {
  EXPLICIT
  USER_CONFIRMED
  OBSERVED
  INFERRED
  HYPOTHESIS
  RETRACTED
}

/// 一条证据是支持还是反对它所指向的那条记忆（任务书 2.2 的支持证据 / 反对证据）。
enum EvidenceKind {
  SUPPORTS
  CONTRADICTS
}

/// 时间信息的精度（任务书 2.1）。模糊时间按原样保留，不许伪造成精确日期。
enum TimePrecision {
  UNKNOWN
  YEAR
  MONTH
  DAY
  TIMESTAMP
}

/// 记忆发生过的演化。不含 CREATED：一条记忆的首版本来就带 sourceMessageId 和
/// recordedAt，再存一份只是把同一件事写两遍。
enum MemoryRevisionAction {
  SUPERSEDED
  RETRACTED
}

/// 后台任务干的是哪一类认知活（任务书 §6）。
/// 只列真实存在的生产者：今天唯一入队的活是「这一轮的记忆写入」。
/// 加一种活 = 一条 ALTER TYPE ADD VALUE + worker 的 MODULE_BY_TASK_KIND 一个条目。
enum CognitiveTaskKind {
  MEMORY
}

/// 没有 SUCCEEDED：跑完就把行删掉，这张表只装「还欠着的活」。
/// 也没有 DISCARDED：模块开关关掉时的作废同样是删行，区别只留在日志事件名里。
/// PENDING 且 availableAt 在未来 = 正在退避重试，所以也不需要 FAILED 态。
enum CognitiveTaskStatus {
  PENDING
  RUNNING
  DEAD
}

/// 任务书 5.5 的五个列表就是这五个状态，不另造词表。
/// REJECTED 也是终态：被拒的候选留着是为了「同一条不再反复来问」，永远不会变成正式记录（7.4 门槛 8）。
enum DecisionStatus {
  PENDING_CONFIRM
  CONFIRMED
  AWAITING_REVIEW
  OUTCOME_RECORDED
  REJECTED
}

/// 任务书 5.1 的六类重要决策。普通聊天里的每个选择不算决策，类别词表就是第一道闸。
enum DecisionCategory {
  TECH_CHOICE
  PROJECT_PLANNING
  CAREER
  LEARNING
  PURCHASE
  PERSONAL_GOAL
}

/// 结果与决策的关联默认只是候选：5.3 不许把结果好坏静默归因到某个单一选择上，
/// 所以这条边要用户在界面上确认或解除后才算数。
enum OutcomeLinkStatus {
  CANDIDATE
  LINKED
  DETACHED
}

/// 主动反思的类型（任务书 6.1），词表照抄不另造。
enum ReflectionType {
  PATTERN
  GOAL_DRIFT
  UNRESOLVED
  INTEREST_SHIFT
  CONTRADICTION
  MILESTONE
  DECISION_LESSON
}

/// 一条反思引用的记忆相对它的位置（任务书 6.4 的主要证据 / 反对证据）。
enum ReflectionCitationKind {
  SUPPORTS
  CONTRADICTS
}

/// 反思的生命周期（任务书 6.4）。六个状态都得有真实生产者：
/// ACCEPTED / REJECTED / EDITED / SNOOZED 由用户动作产生，EXPIRED 由读侧按 expiresAt 判出，
/// PENDING 是生成时的唯一初值。
enum ReflectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EDITED
  SNOOZED
  EXPIRED
}

model User {
  id            String     @id @default(uuid())
  username      String     @unique @db.VarChar(32)
  email         String     @unique @db.VarChar(254)
  emailVerified DateTime?
  passwordHash  String
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  displayName   String?    @db.VarChar(64)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  sessions         Session[]
  chats            Chat[]
  aiProviders      AiProvider[]
  cognitive        CognitivePreference?
  memoryPolicies   MemoryPolicy[]
  memories         MemoryItem[]
  memoryRevisions  MemoryRevision[]
  memoryExclusions MemoryExclusion[]
  policySignals    MemoryPolicySignal[]
  memoryEvidences  MemoryEvidence[]
  cognitiveTasks   CognitiveTask[]
  decisions        DecisionRecord[]
  decisionOutcomes DecisionOutcome[]
  reflections      ReflectionRecord[]
  reflectionCitations ReflectionCitation[]
  attachments      Attachment[]
  loginLogs        LoginLog[]
  auditLogs        AuditLog[]           @relation("AuditActor")
  ipRulesCreated   IpRule[]             @relation("IpRuleCreator")
  configsUpdated   SystemConfig[]       @relation("ConfigUpdater")

  @@index([role])
  @@index([status])
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @db.VarChar(64)
  csrfHash   String    @db.VarChar(64)
  userId     String
  ip         String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(512)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Chat {
  id              String   @id @default(uuid())
  userId          String
  titleCiphertext String   @db.Text
  modelProviderId String?
  modelId         String?  @db.VarChar(128)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    AiProvider?     @relation(fields: [modelProviderId], references: [id], onDelete: SetNull)
  messages    Message[]
  attachments Attachment[]
  memories    MemoryItem[]
  tasks       CognitiveTask[]

  @@index([userId, updatedAt])
  @@index([modelProviderId])
}

model Message {
  id                String        @id @default(uuid())
  chatId            String
  role              MessageRole
  contentCiphertext String        @db.Text
  modelId           String?       @db.VarChar(128)
  providerId        String?
  status            MessageStatus @default(COMPLETE)
  errorCode         String?       @db.VarChar(64)
  inputTokens       Int?
  outputTokens      Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  chat        Chat            @relation(fields: [chatId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  memories    MemoryItem[]    @relation("MemorySource")
  tasks       CognitiveTask[] @relation("CognitiveTaskSource")
  decisions   DecisionRecord[] @relation("DecisionSource")
  outcomes    DecisionOutcome[] @relation("OutcomeSource")

  @@index([chatId, createdAt])
}

model Attachment {
  id                      String         @id @default(uuid())
  userId                  String
  chatId                  String?
  messageId               String?
  kind                    AttachmentKind
  originalNameCiphertext  String         @db.Text
  mime                    String         @db.VarChar(128)
  size                    Int
  sha256                  String         @db.VarChar(64)
  storageKey              String         @unique @db.VarChar(128)
  extractedTextCiphertext String?        @db.Text
  chunksCiphertext        String?        @db.Text
  createdAt               DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat    Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, chatId])
  @@index([userId, createdAt])
  @@index([messageId])
}

model AiProvider {
  id               String        @id @default(uuid())
  ownerType        ProviderOwner
  userId           String?
  name             String        @db.VarChar(64)
  baseUrl          String        @db.VarChar(512)
  apiKeyCiphertext String        @db.Text
  modelId          String        @db.VarChar(128)
  capabilities     Json
  params           Json?
  enabled          Boolean       @default(true)
  isDefault        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats Chat[]

  @@index([ownerType, enabled])
  @@index([userId])
}

model IpRule {
  id            String    @id @default(uuid())
  cidr          String    @unique @db.VarChar(64)
  label         String?   @db.VarChar(128)
  enabled       Boolean   @default(true)
  expiresAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMatchedAt DateTime?

  createdBy User? @relation("IpRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@index([expiresAt])
}

model IpAccessLog {
  id        String   @id @default(uuid())
  ip        String   @db.VarChar(64)
  path      String   @db.VarChar(512)
  method    String   @db.VarChar(16)
  allowed   Boolean
  reason    String?  @db.VarChar(128)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([allowed, createdAt])
}

model LoginLog {
  id         String   @id @default(uuid())
  userId     String?
  identifier String?  @db.VarChar(254)
  ip         String   @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  success    Boolean
  reason     String?  @db.VarChar(128)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

model LoginLock {
  ip          String    @id @db.VarChar(64)
  fails       Int       @default(0)
  firstFailAt DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actorLabel String      @db.VarChar(128)
  action     String      @db.VarChar(128)
  targetType String?     @db.VarChar(64)
  targetId   String?     @db.VarChar(64)
  before     Json?
  after      Json?
  ip         String?     @db.VarChar(64)
  userAgent  String?     @db.VarChar(512)
  status     AuditStatus @default(SUCCESS)
  error      String?     @db.VarChar(512)
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model SystemConfig {
  key         String   @id @db.VarChar(64)
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("ConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model EmailToken {
  id         String            @id @default(uuid())
  email      String            @db.VarChar(254)
  purpose    EmailTokenPurpose
  codeHash   String            @db.VarChar(64)
  username   String?           @db.VarChar(32)
  userId     String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int               @default(0)
  ip         String?           @db.VarChar(64)
  createdAt  DateTime          @default(now())

  @@index([email, purpose, createdAt])
  @@index([userId])
  @@index([expiresAt])
}

/// 认知引擎的用户级开关。八个开关各自独立启用，默认全关——没有这一行也就等于全关。
/// 关掉只停读写，不删任何数据；清空数据是另一个动作（Phase 7 的遗忘接口）。
model CognitivePreference {
  userId                String              @id
  memoryEnabled         Boolean             @default(false)
  userModelEnabled      Boolean             @default(false)
  emotionEnabled        Boolean             @default(false)
  associationEnabled    Boolean             @default(false)
  timelineEnabled       Boolean             @default(false)
  reflectionEnabled     Boolean             @default(false)
  decisionMemoryEnabled Boolean             @default(false)
  adaptiveMemoryEnabled Boolean             @default(false)
  emotionTransparency   EmotionTransparency @default(IMPLICIT)
  /// 上一次跑反思规则的时刻。反思不能挂在每条消息上重算整个记忆池（任务书 6.6 的冷却），
  /// 所以这一列是后台那趟扫描的节流标记，不是用户设置项。
  reflectionSweptAt     DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 自适应记忆策略：同一用户在不同情境下允许记什么、留多久。
/// 默认值取最保守的一档——库里没有行时由应用层补齐内置默认，两者必须等价。
model MemoryPolicy {
  userId              String
  context             MemoryContext
  allowPersistence    Boolean         @default(false)
  allowedMemoryTypes  MemoryType[]    @default([])
  requireConfirmation Boolean         @default(true)
  retention           MemoryRetention @default(SESSION_ONLY)
  allowUserProfile    Boolean         @default(false)
  allowReflection     Boolean         @default(false)
  allowAssociation    Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  /// 学习层自动收紧过这个情境的时刻。非空表示当前配置里有一处不是用户亲手定的。
  learnedAt           DateTime?
  /// 用户在策略界面亲手改过这个情境的时刻。非空即「用户已接管」，学习层不再碰它。
  manualOverrideAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, context])
}

/// 策略学习的证据（任务书 1.3）。只有「永久删除」会产生信号：
/// 撤回不算（用户可能只是想让它别再用，而不是抱怨这个情境记太多），
/// 改记忆更不算（那是想让它记对）。清空全部也不算，那是一次重置，
/// 一口气给七个情境各记几十条信号，等于让学习层瞬间把所有情境都收紧。
model MemoryPolicySignal {
  id        String        @id @default(uuid())
  userId    String
  context   MemoryContext
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, context, createdAt])
}

/// 长期记忆主体（任务书 2.1、2.2）。双时间模型：validFrom/validTo 是事实成立的区间，
/// recordedAt 是系统记下的时间，两者互不替代；区间只有在 validPrecision 支持时才允许精确。
/// 正文加密存储，AAD 绑住 userId 与记录 id——整表导出也读不出内容。
/// 会话或删除时其派生记忆随行cascade 一起消失（Phase 7 的清理口径）。
model MemoryItem {
  id                String        @id @default(uuid())
  userId            String
  chatId            String?
  sourceMessageId   String?
  type              MemoryType
  context           MemoryContext
  origin            MemoryOrigin
  contentCiphertext String        @db.Text
  /// 正文向量的密文（AES-256-GCM，AAD 绑到字段名 `memory-vector:v1:用户:记忆`）。
  /// 和正文一样是密文，所以「存下来的 embedding 算不算明文记忆」这条红线按构造不成立。
  embeddingCiphertext Bytes?
  /// 算出它的那个模型：维度相同但模型不同的两串数不能比，读侧按这一列筛掉。
  embeddingModel      String?
  confirmedAt       DateTime?
  version           Int           @default(1)
  supersededAt      DateTime?
  validFrom         DateTime?
  validTo           DateTime?
  validPrecision    TimePrecision @default(UNKNOWN)
  recordedAt        DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat          Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sourceMessage Message? @relation("MemorySource", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  /// 这条行作为「新版本」产生的演化边，和作为「被取代的旧版本」产生的边。
  revisions       MemoryRevision[] @relation("MemoryRevisionNew")
  replacedByEdges MemoryRevision[] @relation("MemoryRevisionPrevious")
  evidences       MemoryEvidence[]
  /// 反思对这条记忆的引用（Phase 6）。
  reflectionCitations ReflectionCitation[] @relation("ReflectionCitationMemory")

  /// 给 ReflectionCitation 的复合外键用的：(记忆, 用户) 这一对唯一，
  /// 于是别的用户的反思不可能引用到这条记忆上（任务书 5.1 要求在库层兜住）。
  /// id 已经是主键，这条约束在已有数据上必然成立，加它不改任何行。
  @@unique([id, userId])
  @@index([userId, supersededAt])
  @@index([userId, type])
}

/// 一次演化的边（任务书 2.3、3.6）。正文不复制到这里：旧版本仍是原本那条 MemoryItem，
/// 更新时只给它盖 supersededAt 并新写一行，所以历史能逐条读回，谁都不会被覆盖掉。
model MemoryRevision {
  id               String               @id @default(uuid())
  userId           String
  action           MemoryRevisionAction
  memoryId         String
  previousId       String?
  reasonCiphertext String               @db.Text
  sourceMessageId  String?
  createdAt        DateTime             @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory   MemoryItem  @relation("MemoryRevisionNew", fields: [memoryId], references: [id], onDelete: Cascade)
  previous MemoryItem? @relation("MemoryRevisionPrevious", fields: [previousId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([previousId])
  @@index([userId, createdAt])
}

/// 用户永久删除过的内容不再被自动记回来（任务书 7.3 的来源排除规则）。
/// chatId 和 sourceMessageId 故意不建外键：排除必须比来源活得久，
/// 会话被删掉之后，那句话仍然不该被重新记住。
model MemoryExclusion {
  id                String   @id @default(uuid())
  userId            String
  /// HMAC(APP_SECRET, userId:归一化正文)：匹配用，本身不是明文的等价物。
  contentHash       String
  /// 另存一份密文，只为界面能显示和撤销；只有哈希的话用户认不出哪条是哪条。
  contentCiphertext String   @db.Text
  chatId            String?
  sourceMessageId   String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentHash])
  @@index([userId, createdAt])
}

/// 认知证据账本（任务书 2.2）。一条证据只回答「这条记忆凭什么在这里」，不改变它的内容。
///
/// 置信度不存在 MemoryItem 上，而是读时按这些证据算出来：存一列就要维护刷新时机，
/// 漏一处就是一个过期的假数字。
///
/// 复合唯一约束把「同一条消息对同一条记忆只算一次」交给数据库，
/// 而不是靠服务层记得先查一遍（任务书 5.1 要求尽量在库层兜住）。
/// sourceMessageId 可空是给「手工输入的记忆」留的（7.4 门槛 3 允许这种例外，
/// 但要求记下来源类型）；PostgreSQL 的唯一索引把 NULL 视为互不相同，
/// 所以这一类证据的去重由服务层负责，今天的四条产生路径都带消息 id，走的是库层约束。
model MemoryEvidence {
  id              String       @id @default(uuid())
  userId          String
  memoryId        String
  kind            EvidenceKind
  /// 这条证据是怎么来的：用户又原话说了一遍、用户亲手更正、还是系统自己观察/推断的。
  origin          MemoryOrigin
  sourceMessageId String?
  sourceChatId    String?
  /// 可选说明，密文。多数证据不需要正文；留这一列给「用户更正时写的理由」这类东西。
  noteCiphertext  String?      @db.Text
  createdAt       DateTime     @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory MemoryItem @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([userId, memoryId, kind, sourceMessageId])
  @@index([userId, memoryId])
}

/// 认知后台任务队列（任务书 §6）。一行 = 「这一句话的认知写入还欠着」。
///
/// 这张表里没有任何正文：要重建这一轮，靠 sourceMessageId 把 Message 行解密出来——
/// 用户那句话在落库时就是逐字的原文，所以 worker 拿到的 content 与请求体一字不差。
/// 任务书 5.5 那条「不许出现明文」的红线在这里是结构上违反不了的：没有可以放正文的列。
///
/// 成功即删行，作废也删行（区别只在日志事件名）：这张表只装欠着的活，不是历史表，
/// 所以门槛 2「删除要连带清理派生数据」的分母不会随着使用越滚越大。
model CognitiveTask {
  id              String              @id @default(uuid())
  userId          String
  /// 执行不需要它。留着是为了「忘记这次对话」能取消还没跑的活，以及让删会话顺手级联掉这一行。
  chatId          String
  /// 幂等锚点：一条消息的一类任务只欠一次，重复入队由库层唯一约束挡掉（任务书 5.1 要求库层兜住）。
  sourceMessageId String
  kind            CognitiveTaskKind
  status          CognitiveTaskStatus @default(PENDING)
  /// 已发起的执行次数。在领取时 +1，不是失败时 +1：崩在执行半路也要占掉一次，
  /// 否则一个能把进程带死的任务可以无限重试。
  attempts        Int                 @default(0)
  /// 最早可被领取的时刻。新行 = now（立即可用），失败后退避 = 下次再试，
  /// 有了它就不需要 FAILED 状态：待重试是「PENDING 且 availableAt 在未来」。
  availableAt     DateTime            @default(now())
  /// 租约。leaseOwner 同时是 fencing token：租约过年被（下一轮的自己或另一个进程）领走之后，
  /// 上一任僵尸执行的所有完结写入都会因为 owner 不匹配而命中 0 行。
  leaseOwner      String?             @db.VarChar(64)
  leaseUntil      DateTime?
  /// 只有错误码，永远没有报错原文（5.5）：模块抛出的信息里常常带着记忆正文。
  lastErrorCode   String?             @db.VarChar(64)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat          Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sourceMessage Message @relation("CognitiveTaskSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@unique([sourceMessageId, kind])
  @@index([status, availableAt])
  @@index([userId, chatId])
}

/// 决策记忆（任务书 Phase 5）。一条 = 用户在对话里做出的一个重要决策。
///
/// 抽取出来时一律 PENDING_CONFIRM：未经用户确认不建立正式决策记录（7.4 门槛 8），
/// 所以「正式记录」在库里的定义就是 status = CONFIRMED，不靠服务层记得判。
///
/// 九个内容列全是密文（5.2 要求敏感内容加密存储），复用 crypto.ts 的 AES-256-GCM，
/// AAD 绑 userId + recordId + fieldName：把 A 用户的决策行搬到 B 用户名下会解不开。
/// 可空的内容列对应任务书里「可选」的字段；主题和选择不可空，没有这两样就不成其为决策。
model DecisionRecord {
  id                      String           @id @default(uuid())
  userId                  String
  category                DecisionCategory
  status                  DecisionStatus   @default(PENDING_CONFIRM)
  topicCiphertext         String           @db.Text
  choiceCiphertext        String           @db.Text
  backgroundCiphertext    String?          @db.Text
  constraintsCiphertext   String?          @db.Text
  optionsCiphertext       String?          @db.Text
  reasonCiphertext        String?          @db.Text
  criteriaCiphertext      String?          @db.Text
  expectedOutcomeCiphertext String?        @db.Text
  risksCiphertext         String?          @db.Text
  /// 决策发生的时间，不是记录时间：用户今天补说去年的决定时这两者不同（2.1 的口径）。
  decidedAt               DateTime?
  /// 可选的复盘时间。第一版只做站内徽标，不主动推送（5.5）。
  reviewAfter             DateTime?
  confirmedAt             DateTime?
  sourceMessageId         String
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage Message         @relation("DecisionSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)
  outcomes        DecisionOutcome[]
  reflectionCitations ReflectionCitation[] @relation("ReflectionCitationDecision")

  /// 给 DecisionOutcome 的复合外键用的：(决策, 用户)  pair 唯一，
  /// 于是结果行不可能指到别的用户的决策上（任务书 5.1 要求在库层兜住）。
  @@unique([id, userId])
  @@unique([sourceMessageId, category])
  @@index([userId, status])
}

/// 决策的结果跟踪（任务书 5.3）。一条 = 用户后来主动提到的一个结果，和某条决策的关联。
///
/// linkStatus 默认 CANDIDATE：后台只敢提候选，确认或解除由用户在界面上做。
/// 五个内容列全密文，口径同 DecisionRecord。
model DecisionOutcome {
  id                   String            @id @default(uuid())
  userId               String
  decisionId           String
  linkStatus           OutcomeLinkStatus @default(CANDIDATE)
  actualCiphertext     String            @db.Text
  gapCiphertext        String?           @db.Text
  ratingCiphertext     String?           @db.Text
  missedFactorsCiphertext String?        @db.Text
  lessonCiphertext     String?           @db.Text
  sourceMessageId      String
  recordedAt           DateTime          @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage Message        @relation("OutcomeSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)
  /// 复合外键：references 的是 (id, userId) 而不是单 id，
  /// 跨用户连边在数据库层就建不出来。
  decision      DecisionRecord @relation(fields: [decisionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([sourceMessageId, decisionId])
  @@index([userId, decisionId])
  @@index([userId, linkStatus])
}

/// 主动反思的一条洞察（任务书 Phase 6）。
///
/// 这一版由规则出题、规则措辞，正文里每个断言都对应 ReflectionCitation 引着的那几行记忆，
/// 所以「无来源的确定事实」在这张表上是写不出来的（7.4 门槛 5）。
///
/// 状态默认且只能以 PENDING 落地：一条推断在用户点它之前只是候选，
/// 不改画像、不覆盖记忆、不触发动作（任务书 6.5、门槛 7）。
model ReflectionRecord {
  id                     String           @id @default(uuid())
  userId                 String
  type                   ReflectionType
  status                 ReflectionStatus @default(PENDING)
  /// 同主题去重键（任务书 6.6）：type + 主题词集的稳定摘要。
  /// 库里 @@unique([userId, dedupKey]) 让重复主题的第二条根本插不进来，不是靠应用层记着。
  dedupKey               String           @db.VarChar(80)
  titleCiphertext        String           @db.Text
  bodyCiphertext         String           @db.Text
  /// 竞争解释（任务书 6.3）：规则分不开「长期兴趣 / 阶段性项目 / 临时学习」这类情形时，
  /// 把几种解释和各自还缺什么证据一起列出来，一条都不选。
  alternativesCiphertext String?          @db.Text
  /// 反证搜索用过的关键词集合本身也是记忆正文的派生物，按同样的口径加密。
  counterTokensCiphertext String         @db.Text
  /// 反证命中了几条。0 也要留行：门槛 4 要的是「搜过反证」这件事有凭据，
  /// 而不只是「找到了反证」。
  counterHitCount        Int
  /// 时间范围按原样保留精度：模糊时间不许伪造成精确日期（7.4 门槛 6）。
  timeFrom               DateTime?
  timeTo                 DateTime?
  timePrecision          TimePrecision    @default(UNKNOWN)
  /// 样本数量与观察时间跨度（任务书 4.3、6.3）：数据不足时这两个数就是
  /// INSUFFICIENT_EVIDENCE 的判据本身，界面上也要把它们摊开给用户看。
  sampleCount            Int
  observationSpanDays    Int
  /// 置信度由 reflection-evidence 的 reflectionConfidence 按样本数、跨度与反证命中算出来再落库，
  /// 不接受任何口算数字。
  confidence             Float
  /// 重要程度：证据条数与时间跨度的档位分，只用于排序和「最多留 3 条」的取舍。
  importance             Float
  generatedAt            DateTime         @default(now())
  /// SNOOZED 到什么时候才允许重新摆到用户面前。
  snoozedUntil           DateTime?
  /// 过了这一刻，读侧把 PENDING 判成 EXPIRED（任务书 6.4 的最后一个状态）。
  expiresAt              DateTime?
  /// 用户做出动作（采纳/忽略/改/稍后）的时刻。
  decidedAt              DateTime?
  updatedAt              DateTime         @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations ReflectionCitation[]

  /// 给自己的引用行的复合外键用的：(洞察, 用户) 这一对唯一。
  @@unique([id, userId])
  @@unique([userId, dedupKey])
  @@index([userId, status])
  @@index([userId, generatedAt])
}

/// 一条反思引用的证据、站在支持还是反对的一侧（任务书 6.4 的主要证据 / 反对证据）。
///
/// 用连接表而不是把 id 串成一列写进正文列：这样跨用户引用在库层就建不出来，
/// 而且来源被永久删除时这条引用随行消失——Phase 7「删记忆要连带处理反思里的相关内容」
/// 就是这一条 cascade，读侧再按剩下几条引用判这条洞察还该不该留着。
///
/// 来源可以是记忆，也可以是决策：6.1 的 DECISION_LESSON 和「决策落定」那一类 MILESTONE
/// 的证据本来就是 DecisionRecord 那两行，硬把它们转写成记忆 id 就是造假。
/// **恰好一列非空**由服务层保证（写这一行的只有 reflection 生成那一条代码路径）：
/// Prisma 表达不了 CHECK，而在迁移里手写一条 CHECK 会让下一次 migrate diff 想把它删掉。
model ReflectionCitation {
  id           String                 @id @default(uuid())
  userId       String
  reflectionId String
  memoryId     String?
  decisionId   String?
  kind         ReflectionCitationKind
  createdAt    DateTime               @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflection ReflectionRecord @relation(fields: [reflectionId, userId], references: [id, userId], onDelete: Cascade)
  memory     MemoryItem?      @relation("ReflectionCitationMemory", fields: [memoryId, userId], references: [id, userId], onDelete: Cascade)
  decision   DecisionRecord?  @relation("ReflectionCitationDecision", fields: [decisionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([reflectionId, memoryId])
  @@unique([reflectionId, decisionId])
  @@index([userId, reflectionId])
  @@index([userId, memoryId])
  @@index([userId, decisionId])
}
