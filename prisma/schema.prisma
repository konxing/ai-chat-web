generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProviderOwner {
  GLOBAL
  USER
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum MessageStatus {
  COMPLETE
  PARTIAL
  ERROR
}

enum AttachmentKind {
  IMAGE
  FILE
  AUDIO
}

enum EmailTokenPurpose {
  REGISTER
  RESET
  EMAIL_CHANGE
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum EmotionTransparency {
  OFF
  IMPLICIT
  EXPLICIT
}

enum ReflectionCooldown {
  DAILY
  WEEKLY
  MONTHLY
}

/// 任务书 1.2 的七种交互情境。每个用户每种情境一行策略。
enum MemoryContext {
  GENERAL
  TECHNICAL_PROJECT
  LEARNING
  PERSONAL_GOAL
  PERSONAL_REFLECTION
  EMOTIONAL_SUPPORT
  DECISION_MAKING
}

enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  PROJECT
  DECISION
  EMOTION
}

enum MemoryRetention {
  FOREVER
  UNTIL_SUPERSEDED
  DAYS_30
  DAYS_90
  SESSION_ONLY
}

/// 一条记忆的认识论地位（任务书 2.2）。推断和假设永远不等于用户说过或确认过。
enum MemoryOrigin {
  EXPLICIT
  USER_CONFIRMED
  OBSERVED
  INFERRED
  HYPOTHESIS
  RETRACTED
}

/// 一条证据是支持还是反对它所指向的那条记忆（任务书 2.2 的支持证据 / 反对证据）。
enum EvidenceKind {
  SUPPORTS
  CONTRADICTS
}

/// 时间信息的精度（任务书 2.1）。模糊时间按原样保留，不许伪造成精确日期。
enum TimePrecision {
  UNKNOWN
  YEAR
  MONTH
  DAY
  TIMESTAMP
}

/// 记忆发生过的演化。不含 CREATED：一条记忆的首版本来就带 sourceMessageId 和
/// recordedAt，再存一份只是把同一件事写两遍。
enum MemoryRevisionAction {
  SUPERSEDED
  RETRACTED
}

/// 记忆之间关系的类型（任务书 2.3 的八种）。
/// 只有「有证据」的类型才允许系统自动建立；CAUSES_WITH_EVIDENCE 不许按时间先后自动生成。
enum MemoryRelationType {
  RELATED_TO
  SAME_TOPIC
  SUPPORTS
  CONTRADICTS
  EVOLVES_FROM
  PART_OF
  OCCURRED_BEFORE
  CAUSES_WITH_EVIDENCE
}

/// 这条关系是谁建的：系统按可复核的规则，还是用户自己连的。
enum MemoryRelationOrigin {
  SYSTEM
  USER
}

/// 关系本身的状态。REJECTED 只用于「用户否掉」；来源或目标失效不删边，
/// 由读侧按记忆行的 superseded/archived/validTo 过滤——删边会让「为什么曾经关联」消失。
enum MemoryRelationStatus {
  ACTIVE
  REJECTED
}

/// 「先问再记」问出来的那句话处于哪一步（任务书 1.2 的 ASK_CONFIRM）。
/// 只有三个值是有原因的：没有「过期」「忽略」「稍后再问」——用户不理它，它就一直是 PENDING，
/// 顶多被新候选按数量挤掉；再加状态就是给同一件事发明第二种「不记」的说法。
enum MemoryCandidateStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// 后台任务干的是哪一类认知活（任务书 §6）。
/// 只列真实存在的生产者：今天唯一入队的活是「这一轮的记忆写入」。
/// 加一种活 = 一条 ALTER TYPE ADD VALUE + worker 的 MODULE_BY_TASK_KIND 一个条目。
enum CognitiveTaskKind {
  MEMORY
}

/// 没有 SUCCEEDED：跑完就把行删掉，这张表只装「还欠着的活」。
/// 也没有 DISCARDED：模块开关关掉时的作废同样是删行，区别只留在日志事件名里。
/// PENDING 且 availableAt 在未来 = 正在退避重试，所以也不需要 FAILED 态。
enum CognitiveTaskStatus {
  PENDING
  RUNNING
  DEAD
}

/// 任务书 5.5 的五个列表就是这五个状态，不另造词表。
/// REJECTED 也是终态：被拒的候选留着是为了「同一条不再反复来问」，永远不会变成正式记录（7.4 门槛 8）。
enum DecisionStatus {
  PENDING_CONFIRM
  CONFIRMED
  AWAITING_REVIEW
  OUTCOME_RECORDED
  REJECTED
}

/// 任务书 5.1 的六类重要决策。普通聊天里的每个选择不算决策，类别词表就是第一道闸。
enum DecisionCategory {
  TECH_CHOICE
  PROJECT_PLANNING
  CAREER
  LEARNING
  PURCHASE
  PERSONAL_GOAL
}

/// 结果与决策的关联默认只是候选：5.3 不许把结果好坏静默归因到某个单一选择上，
/// 所以这条边要用户在界面上确认或解除后才算数。
enum OutcomeLinkStatus {
  CANDIDATE
  LINKED
  DETACHED
}

/// 主动反思的类型（任务书 6.1），词表照抄不另造。
enum ReflectionType {
  PATTERN
  GOAL_DRIFT
  UNRESOLVED
  INTEREST_SHIFT
  CONTRADICTION
  MILESTONE
  DECISION_LESSON
}

/// 一条反思引用的记忆相对它的位置（任务书 6.4 的主要证据 / 反对证据）。
enum ReflectionCitationKind {
  SUPPORTS
  CONTRADICTS
}

/// 反思的生命周期（任务书 6.4）。六个状态都得有真实生产者：
/// ACCEPTED / REJECTED / EDITED / SNOOZED 由用户动作产生，EXPIRED 由读侧按 expiresAt 判出，
/// PENDING 是生成时的唯一初值。
enum ReflectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  EDITED
  SNOOZED
  EXPIRED
}

model User {
  id            String     @id @default(uuid())
  username      String     @unique @db.VarChar(32)
  email         String     @unique @db.VarChar(254)
  emailVerified DateTime?
  passwordHash  String
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  displayName   String?    @db.VarChar(64)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  sessions            Session[]
  chats               Chat[]
  aiProviders         AiProvider[]
  cognitive           CognitivePreference?
  memoryPolicies      MemoryPolicy[]
  memories            MemoryItem[]
  memoryRevisions     MemoryRevision[]
  memoryRelations     MemoryRelation[]
  memoryExclusions    MemoryExclusion[]
  memoryCandidates    MemoryCandidate[]
  policySignals       MemoryPolicySignal[]
  memoryEvidences     MemoryEvidence[]
  cognitiveTasks      CognitiveTask[]
  decisions           DecisionRecord[]
  decisionOutcomes    DecisionOutcome[]
  reflections         ReflectionRecord[]
  reflectionCitations ReflectionCitation[]
  memoryAccessTurns   MemoryAccessTurn[]
  memoryVerifications MemoryVerification[]
  dreamingRun DreamingRun?
  knowledgePages KnowledgePage[]
  experienceNotes ExperienceNote[]
  userProfileEntries  UserProfileEntry[]
  capabilityDimensions CapabilityDimension[]
  capabilityEvidences CapabilityEvidence[]
  capabilitySnapshots CapabilitySnapshot[]
  interventionRecords InterventionRecord[]
  attachments         Attachment[]
  loginLogs           LoginLog[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  ipRulesCreated      IpRule[]             @relation("IpRuleCreator")
  configsUpdated      SystemConfig[]       @relation("ConfigUpdater")

  @@index([role])
  @@index([status])
}

model Session {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @db.VarChar(64)
  csrfHash   String    @db.VarChar(64)
  userId     String
  ip         String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(512)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Chat {
  id              String   @id @default(uuid())
  userId          String
  titleCiphertext String   @db.Text
  modelProviderId String?
  modelId         String?  @db.VarChar(128)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         AiProvider?       @relation(fields: [modelProviderId], references: [id], onDelete: SetNull)
  messages         Message[]
  attachments      Attachment[]
  memories         MemoryItem[]
  memoryCandidates MemoryCandidate[]
  tasks            CognitiveTask[]

  @@index([userId, updatedAt])
  @@index([modelProviderId])
}

model Message {
  id                String        @id @default(uuid())
  chatId            String
  role              MessageRole
  contentCiphertext String        @db.Text
  modelId           String?       @db.VarChar(128)
  providerId        String?
  status            MessageStatus @default(COMPLETE)
  errorCode         String?       @db.VarChar(64)
  inputTokens       Int?
  outputTokens      Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  chat        Chat               @relation(fields: [chatId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  memories    MemoryItem[]       @relation("MemorySource")
  candidates  MemoryCandidate[]  @relation("CandidateSource")
  tasks       CognitiveTask[]    @relation("CognitiveTaskSource")
  accessTurns MemoryAccessTurn[] @relation("MemoryAccessTurnSource")
  decisions   DecisionRecord[]   @relation("DecisionSource")
  outcomes    DecisionOutcome[]  @relation("OutcomeSource")
  capabilityEvidences CapabilityEvidence[] @relation("CapabilityEvidenceSource")

  @@index([chatId, createdAt])
}

model Attachment {
  id                      String         @id @default(uuid())
  userId                  String
  chatId                  String?
  messageId               String?
  kind                    AttachmentKind
  originalNameCiphertext  String         @db.Text
  mime                    String         @db.VarChar(128)
  size                    Int
  sha256                  String         @db.VarChar(64)
  storageKey              String         @unique @db.VarChar(128)
  extractedTextCiphertext String?        @db.Text
  chunksCiphertext        String?        @db.Text
  createdAt               DateTime       @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat    Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, chatId])
  @@index([userId, createdAt])
  @@index([messageId])
}

model AiProvider {
  id               String        @id @default(uuid())
  ownerType        ProviderOwner
  userId           String?
  name             String        @db.VarChar(64)
  baseUrl          String        @db.VarChar(512)
  apiKeyCiphertext String        @db.Text
  modelId          String        @db.VarChar(128)
  capabilities     Json
  params           Json?
  enabled          Boolean       @default(true)
  isDefault        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats Chat[]

  @@index([ownerType, enabled])
  @@index([userId])
}

model IpRule {
  id            String    @id @default(uuid())
  cidr          String    @unique @db.VarChar(64)
  label         String?   @db.VarChar(128)
  enabled       Boolean   @default(true)
  expiresAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMatchedAt DateTime?

  createdBy User? @relation("IpRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@index([expiresAt])
}

model IpAccessLog {
  id        String   @id @default(uuid())
  ip        String   @db.VarChar(64)
  path      String   @db.VarChar(512)
  method    String   @db.VarChar(16)
  allowed   Boolean
  reason    String?  @db.VarChar(128)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([allowed, createdAt])
}

model LoginLog {
  id         String   @id @default(uuid())
  userId     String?
  identifier String?  @db.VarChar(254)
  ip         String   @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  success    Boolean
  reason     String?  @db.VarChar(128)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
}

model LoginLock {
  ip          String    @id @db.VarChar(64)
  fails       Int       @default(0)
  firstFailAt DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actorLabel String      @db.VarChar(128)
  action     String      @db.VarChar(128)
  targetType String?     @db.VarChar(64)
  targetId   String?     @db.VarChar(64)
  before     Json?
  after      Json?
  ip         String?     @db.VarChar(64)
  userAgent  String?     @db.VarChar(512)
  status     AuditStatus @default(SUCCESS)
  error      String?     @db.VarChar(512)
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model SystemConfig {
  key         String   @id @db.VarChar(64)
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation("ConfigUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model EmailToken {
  id         String            @id @default(uuid())
  email      String            @db.VarChar(254)
  purpose    EmailTokenPurpose
  codeHash   String            @db.VarChar(64)
  username   String?           @db.VarChar(32)
  userId     String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int               @default(0)
  ip         String?           @db.VarChar(64)
  createdAt  DateTime          @default(now())

  @@index([email, purpose, createdAt])
  @@index([userId])
  @@index([expiresAt])
}

/// 认知引擎的用户级开关。八个开关各自独立启用，默认全关——没有这一行也就等于全关。
/// 关掉只停读写，不删任何数据；清空数据是另一个动作（Phase 7 的遗忘接口）。
model CognitivePreference {
  userId                String              @id
  memoryEnabled         Boolean             @default(false)
  userModelEnabled      Boolean             @default(false)
  emotionEnabled        Boolean             @default(false)
  associationEnabled    Boolean             @default(false)
  timelineEnabled       Boolean             @default(false)
  reflectionEnabled     Boolean             @default(false)
  decisionMemoryEnabled Boolean             @default(false)
  adaptiveMemoryEnabled Boolean             @default(false)
  emotionTransparency   EmotionTransparency @default(IMPLICIT)
  /// 任务书 6.6 :722 的「可配置的冷却规则」：两次生成洞察之间至少隔多久。白名单三档而不是一个整数，
  /// 因为后台那趟扫描是 O(n²) 聚类，把下限放开到一天以下等于让人手动把整池记忆重算成每分钟一次。
  /// 默认 DAILY = 加上这一列之前写死的那 24 小时：新增设置项不该顺带改掉现存用户的节奏。
  reflectionCooldown    ReflectionCooldown  @default(DAILY)
  /// 任务书 7.3 的「暂停长期记忆写入」。它不是第九个模块开关：模块开关管「这个模块要不要工作」
  /// （关掉后读侧也不注入），这一列只管「还记不记新东西」——后台不再落库，已存的记忆照常带入对话。
  /// 「记住但不带入」和「暂停写入但继续带入」必须是两件事，所以闸门只放在写侧的最早一处。
  memoryWritePaused     Boolean             @default(false)
  /// 任务书 8.3 的「记忆检索设置」：每一轮最多把几条记忆带进对话（1–8，默认 8）。
  /// 读者是读侧 `selectMemoryCandidates`；上限 8 与任务书 3.2 的默认注入条数一致，
  /// 放开到 8 以上等于让一次回答吃更多提示词预算，不是用户能单方面扩的。
  memoryReadLimit       Int                 @default(8)
  /// 用户本地时区相对 UTC 的偏移（分钟，东八区 = 480）。打开聊天页时由浏览器自动同步。
  /// 「昨天/去年」这类相对说法锚的是用户墙钟而不是服务器的 UTC；null = 还没同步过，按 UTC 处理。
  timezoneOffsetMinutes Int?
  /// 上一次跑反思规则的时刻。反思不能挂在每条消息上重算整个记忆池（任务书 6.6 的冷却），
  /// 所以这一列是后台那趟扫描的节流标记，不是用户设置项。
  reflectionSweptAt     DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 自适应记忆策略：同一用户在不同情境下允许记什么、留多久。
/// 默认值取最保守的一档——库里没有行时由应用层补齐内置默认，两者必须等价。
model MemoryPolicy {
  userId              String
  context             MemoryContext
  allowPersistence    Boolean         @default(false)
  allowedMemoryTypes  MemoryType[]    @default([])
  requireConfirmation Boolean         @default(true)
  retention           MemoryRetention @default(SESSION_ONLY)
  allowUserProfile    Boolean         @default(false)
  allowReflection     Boolean         @default(false)
  allowAssociation    Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  /// 学习层自动收紧过这个情境的时刻。非空表示当前配置里有一处不是用户亲手定的。
  learnedAt           DateTime?
  /// 用户在策略界面亲手改过这个情境的时刻。非空即「用户已接管」，学习层不再碰它。
  manualOverrideAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, context])
}

/// 策略学习的证据（任务书 1.3）。只有「永久删除」会产生信号：
/// 撤回不算（用户可能只是想让它别再用，而不是抱怨这个情境记太多），
/// 改记忆更不算（那是想让它记对）。清空全部也不算，那是一次重置，
/// 一口气给七个情境各记几十条信号，等于让学习层瞬间把所有情境都收紧。
model MemoryPolicySignal {
  id        String        @id @default(uuid())
  userId    String
  context   MemoryContext
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, context, createdAt])
}

/// 长期记忆主体（任务书 2.1、2.2）。双时间模型：validFrom/validTo 是事实成立的区间，
/// recordedAt 是系统记下的时间，两者互不替代；区间只有在 validPrecision 支持时才允许精确。
/// 正文加密存储，AAD 绑住 userId 与记录 id——整表导出也读不出内容。
/// 会话或删除时其派生记忆随行cascade 一起消失（Phase 7 的清理口径）。
model MemoryItem {
  id                  String        @id @default(uuid())
  userId              String
  chatId              String?
  sourceMessageId     String?
  type                MemoryType
  context             MemoryContext
  origin              MemoryOrigin
  contentCiphertext   String        @db.Text
  /// 正文向量的密文（AES-256-GCM，AAD 绑到字段名 `memory-vector:v1:用户:记忆`）。
  /// 和正文一样是密文，所以「存下来的 embedding 算不算明文记忆」这条红线按构造不成立。
  embeddingCiphertext Bytes?
  /// 算出它的那个模型：维度相同但模型不同的两串数不能比，读侧按这一列筛掉。
  embeddingModel      String?
  confirmedAt         DateTime?
  version             Int           @default(1)
  supersededAt        DateTime?
  /// 归档（任务书 7.2 的 ARCHIVE「归档，仍可在允许范围内恢复」）。非空＝这行退出「当前有效」，
  /// 但正文、证据、演化边、向量全留着：恢复只清这一列，所以回得去归档前那一条本身。
  /// 不借 origin=RETRACTED 表达「收起」，因为那个原值一旦覆写就换不回来。
  archivedAt          DateTime?
  validFrom           DateTime?
  validTo             DateTime?
  validPrecision      TimePrecision @default(UNKNOWN)
  recordedAt          DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat          Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sourceMessage Message? @relation("MemorySource", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  /// 这条行作为「新版本」产生的演化边，和作为「被取代的旧版本」产生的边。
  revisions           MemoryRevision[]     @relation("MemoryRevisionNew")
  replacedByEdges     MemoryRevision[]     @relation("MemoryRevisionPrevious")
  evidences           MemoryEvidence[]
  verification        MemoryVerification?
  wikiCitations       KnowledgeCitation[]
  experiences         ExperienceNote[]
  /// 这条行作为起点的关系，和作为终点的关系（任务书 2.3）。
  relationsFrom       MemoryRelation[]     @relation("MemoryRelationSource")
  relationsTo         MemoryRelation[]     @relation("MemoryRelationTarget")
  /// 反思对这条记忆的引用（Phase 6）。
  reflectionCitations ReflectionCitation[] @relation("ReflectionCitationMemory")

  /// 给 ReflectionCitation 的复合外键用的：(记忆, 用户) 这一对唯一，
  /// 于是别的用户的反思不可能引用到这条记忆上（任务书 5.1 要求在库层兜住）。
  /// id 已经是主键，这条约束在已有数据上必然成立，加它不改任何行。
  @@unique([id, userId])
  @@index([userId, supersededAt])
  @@index([userId, type])
}

/// 一次演化的边（任务书 2.3、3.6）。正文不复制到这里：旧版本仍是原本那条 MemoryItem，
/// 更新时只给它盖 supersededAt 并新写一行，所以历史能逐条读回，谁都不会被覆盖掉。
model MemoryRevision {
  id               String               @id @default(uuid())
  userId           String
  action           MemoryRevisionAction
  memoryId         String
  previousId       String?
  reasonCiphertext String               @db.Text
  sourceMessageId  String?
  createdAt        DateTime             @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory   MemoryItem  @relation("MemoryRevisionNew", fields: [memoryId], references: [id], onDelete: Cascade)
  previous MemoryItem? @relation("MemoryRevisionPrevious", fields: [previousId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([previousId])
  @@index([userId, createdAt])
}

/// 记忆之间的关系（任务书 2.3 / 3.1）。
///
/// 为什么现在建：2a 当时量的是「按相似度阈值自动连边值不值得」，结论是不值得；
/// 任务书 2.3 要的是这张表本身（八种类型、来源、置信度、证据），两者不是同一件事。
/// 系统今天只自动建两种有确定证据的边：EVOLVES_FROM（演化边）和 SAME_TOPIC（同主题词重合）。
/// 其余类型只认显式写入，CAUSES_WITH_EVIDENCE 永远不按时间先后自动生成。
///
/// 两端都用 (id, userId) 复合外键：别人的记忆连不进来，跨用户边在库层就插不进去（5.1）。
/// 删除任一端记忆时边随行级联消失——边是派生记录，不该比它的端点活得久。
model MemoryRelation {
  id             String                @id @default(uuid())
  userId         String
  sourceMemoryId String
  targetMemoryId String
  relationType   MemoryRelationType
  /// 0..1。没有证据的系统边不许超过 0.5；读侧扩展只走 ACTIVE 且 >= 阈值。
  confidence     Float                 @default(0.5)
  origin         MemoryRelationOrigin   @default(SYSTEM)
  status         MemoryRelationStatus   @default(ACTIVE)
  /// 证据引用：来源消息 / 演化边 / 用户操作的 id。空数组不是错，但高置信度必须有。
  evidenceIds    String[]              @default([])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  source MemoryItem @relation("MemoryRelationSource", fields: [sourceMemoryId, userId], references: [id, userId], onDelete: Cascade)
  target MemoryItem @relation("MemoryRelationTarget", fields: [targetMemoryId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, sourceMemoryId, targetMemoryId, relationType])
  @@index([userId, sourceMemoryId, status])
  @@index([userId, targetMemoryId, status])
}

/// 用户永久删除过的内容不再被自动记回来（任务书 7.3 的来源排除规则）。
/// chatId 和 sourceMessageId 故意不建外键：排除必须比来源活得久，
/// 会话被删掉之后，那句话仍然不该被重新记住。
model MemoryExclusion {
  id                String   @id @default(uuid())
  userId            String
  /// HMAC(APP_SECRET, userId:归一化正文)：匹配用，本身不是明文的等价物。
  contentHash       String
  /// 另存一份密文，只为界面能显示和撤销；只有哈希的话用户认不出哪条是哪条。
  contentCiphertext String   @db.Text
  chatId            String?
  sourceMessageId   String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentHash])
  @@index([userId, createdAt])
}

/// 「先问再记」问出来的那句话（任务书 1.2 的 ASK_CONFIRM，第七种写入动作里的第五种）。
///
/// 为什么另开一张表，而不是在 MemoryItem 上加一列 status：
/// **没确认的话在任何一条现有读路径上都不得出现。** MemoryItem 已经有对话注入、时间线、变化、
/// 记忆网络、洞察、画像六条读路，加一列就得每条都记得过滤——漏一处的后果是
/// 「系统把自己的猜测当成用户说过的话带进提示词」，那正是任务书结尾禁止的事。
/// 表分开，这类错误按结构就不可能发生。
///
/// 正文和 MemoryItem 同等对待：AES-256-GCM，AAD 绑住这一行自己的 userId 和 id。
/// contentHash 复用排除规则那一份 HMAC(APP_SECRET, userId:归一化正文)——
/// 「这句是不是已经问过了」和「这句是不是被删过」必须是同一个「这句」的定义。
///
/// (userId, contentHash) 唯一同时兜住两件事：待确认期间同一句不重复问，
/// 已经答过「不」的那句以后也不再回来烦人。
model MemoryCandidate {
  id                String                @id @default(uuid())
  userId            String
  chatId            String?
  sourceMessageId   String?
  type              MemoryType
  context           MemoryContext
  contentCiphertext String                @db.Text
  contentHash       String
  status            MemoryCandidateStatus @default(PENDING)
  /// 提出这句话时读到的时间说法。确认时原样带进 MemoryItem，不在这里二次解释。
  validPrecision    TimePrecision         @default(UNKNOWN)
  validFrom         DateTime?
  /// 用户点确认或点的时刻。PENDING 恒为 null——「没答」和「答了」用这一列分，不用时间猜。
  decidedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat          Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sourceMessage Message? @relation("CandidateSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@unique([userId, contentHash])
  @@index([userId, status, createdAt])
}

/// 认知证据账本（任务书 2.2）。一条证据只回答「这条记忆凭什么在这里」，不改变它的内容。
///
/// 置信度不存在 MemoryItem 上，而是读时按这些证据算出来：存一列就要维护刷新时机，
/// 漏一处就是一个过期的假数字。
///
/// 复合唯一约束把「同一条消息对同一条记忆只算一次」交给数据库，
/// 而不是靠服务层记得先查一遍（任务书 5.1 要求尽量在库层兜住）。
/// sourceMessageId 可空是给「手工输入的记忆」留的（7.4 门槛 3 允许这种例外，
/// 但要求记下来源类型）；PostgreSQL 的唯一索引把 NULL 视为互不相同，
/// 所以这一类证据的去重由服务层负责，今天的四条产生路径都带消息 id，走的是库层约束。
model MemoryEvidence {
  id              String       @id @default(uuid())
  userId          String
  memoryId        String
  kind            EvidenceKind
  /// 这条证据是怎么来的：用户又原话说了一遍、用户亲手更正、还是系统自己观察/推断的。
  origin          MemoryOrigin
  sourceMessageId String?
  sourceChatId    String?
  /// 可选说明，密文。多数证据不需要正文；留这一列给「用户更正时写的理由」这类东西。
  noteCiphertext  String?      @db.Text
  createdAt       DateTime     @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory MemoryItem @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([userId, memoryId, kind, sourceMessageId])
  @@index([userId, memoryId])
}

/// 认知后台任务队列（任务书 §6）。一行 = 「这一句话的认知写入还欠着」。
///
/// 这张表里没有任何正文：要重建这一轮，靠 sourceMessageId 把 Message 行解密出来——
/// 用户那句话在落库时就是逐字的原文，所以 worker 拿到的 content 与请求体一字不差。
/// 任务书 5.5 那条「不许出现明文」的红线在这里是结构上违反不了的：没有可以放正文的列。
///
/// 成功即删行，作废也删行（区别只在日志事件名）：这张表只装欠着的活，不是历史表，
/// 所以门槛 2「删除要连带清理派生数据」的分母不会随着使用越滚越大。
model CognitiveTask {
  id              String              @id @default(uuid())
  userId          String
  /// 执行不需要它。留着是为了「忘记这次对话」能取消还没跑的活，以及让删会话顺手级联掉这一行。
  chatId          String
  /// 幂等锚点：一条消息的一类任务只欠一次，重复入队由库层唯一约束挡掉（任务书 5.1 要求库层兜住）。
  sourceMessageId String
  kind            CognitiveTaskKind
  status          CognitiveTaskStatus @default(PENDING)
  /// 已发起的执行次数。在领取时 +1，不是失败时 +1：崩在执行半路也要占掉一次，
  /// 否则一个能把进程带死的任务可以无限重试。
  attempts        Int                 @default(0)
  /// 最早可被领取的时刻。新行 = now（立即可用），失败后退避 = 下次再试，
  /// 有了它就不需要 FAILED 状态：待重试是「PENDING 且 availableAt 在未来」。
  availableAt     DateTime            @default(now())
  /// 租约。leaseOwner 同时是 fencing token：租约过年被（下一轮的自己或另一个进程）领走之后，
  /// 上一任僵尸执行的所有完结写入都会因为 owner 不匹配而命中 0 行。
  leaseOwner      String?             @db.VarChar(64)
  leaseUntil      DateTime?
  /// 只有错误码，永远没有报错原文（5.5）：模块抛出的信息里常常带着记忆正文。
  lastErrorCode   String?             @db.VarChar(64)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat          Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sourceMessage Message @relation("CognitiveTaskSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@unique([sourceMessageId, kind])
  @@index([status, availableAt])
  @@index([userId, chatId])
}

/// 决策记忆（任务书 Phase 5）。一条 = 用户在对话里做出的一个重要决策。
///
/// 抽取出来时一律 PENDING_CONFIRM：未经用户确认不建立正式决策记录（7.4 门槛 8），
/// 所以「正式记录」在库里的定义就是 status = CONFIRMED，不靠服务层记得判。
///
/// 九个内容列全是密文（5.2 要求敏感内容加密存储），复用 crypto.ts 的 AES-256-GCM，
/// AAD 绑 userId + recordId + fieldName：把 A 用户的决策行搬到 B 用户名下会解不开。
/// 可空的内容列对应任务书里「可选」的字段；主题和选择不可空，没有这两样就不成其为决策。
model DecisionRecord {
  id                        String           @id @default(uuid())
  userId                    String
  category                  DecisionCategory
  status                    DecisionStatus   @default(PENDING_CONFIRM)
  topicCiphertext           String           @db.Text
  choiceCiphertext          String           @db.Text
  backgroundCiphertext      String?          @db.Text
  constraintsCiphertext     String?          @db.Text
  optionsCiphertext         String?          @db.Text
  reasonCiphertext          String?          @db.Text
  criteriaCiphertext        String?          @db.Text
  expectedOutcomeCiphertext String?          @db.Text
  risksCiphertext           String?          @db.Text
  /// 决策发生的时间，不是记录时间：用户今天补说去年的决定时这两者不同（2.1 的口径）。
  decidedAt                 DateTime?
  /// 可选的复盘时间。第一版只做站内徽标，不主动推送（5.5）。
  reviewAfter               DateTime?
  confirmedAt               DateTime?
  sourceMessageId           String
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage       Message              @relation("DecisionSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)
  outcomes            DecisionOutcome[]
  reflectionCitations ReflectionCitation[] @relation("ReflectionCitationDecision")

  /// 给 DecisionOutcome 的复合外键用的：(决策, 用户)  pair 唯一，
  /// 于是结果行不可能指到别的用户的决策上（任务书 5.1 要求在库层兜住）。
  @@unique([id, userId])
  @@unique([sourceMessageId, category])
  @@index([userId, status])
}

/// 决策的结果跟踪（任务书 5.3）。一条 = 用户后来主动提到的一个结果，和某条决策的关联。
///
/// linkStatus 默认 CANDIDATE：后台只敢提候选，确认或解除由用户在界面上做。
/// 五个内容列全密文，口径同 DecisionRecord。
model DecisionOutcome {
  id                      String            @id @default(uuid())
  userId                  String
  decisionId              String
  linkStatus              OutcomeLinkStatus @default(CANDIDATE)
  actualCiphertext        String            @db.Text
  gapCiphertext           String?           @db.Text
  ratingCiphertext        String?           @db.Text
  missedFactorsCiphertext String?           @db.Text
  lessonCiphertext        String?           @db.Text
  sourceMessageId         String
  recordedAt              DateTime          @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage Message        @relation("OutcomeSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)
  /// 复合外键：references 的是 (id, userId) 而不是单 id，
  /// 跨用户连边在数据库层就建不出来。
  decision      DecisionRecord @relation(fields: [decisionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([sourceMessageId, decisionId])
  @@index([userId, decisionId])
  @@index([userId, linkStatus])
}

/// 主动反思的一条洞察（任务书 Phase 6）。
///
/// 这一版由规则出题、规则措辞，正文里每个断言都对应 ReflectionCitation 引着的那几行记忆，
/// 所以「无来源的确定事实」在这张表上是写不出来的（7.4 门槛 5）。
///
/// 状态默认且只能以 PENDING 落地：一条推断在用户点它之前只是候选，
/// 不改画像、不覆盖记忆、不触发动作（任务书 6.5、门槛 7）。
model ReflectionRecord {
  id                      String           @id @default(uuid())
  userId                  String
  type                    ReflectionType
  status                  ReflectionStatus @default(PENDING)
  /// 同主题去重键（任务书 6.6）：type + 主题词集的稳定摘要。
  /// 库里 @@unique([userId, dedupKey]) 让重复主题的第二条根本插不进来，不是靠应用层记着。
  dedupKey                String           @db.VarChar(80)
  titleCiphertext         String           @db.Text
  bodyCiphertext          String           @db.Text
  /// 竞争解释（任务书 6.3）：规则分不开「长期兴趣 / 阶段性项目 / 临时学习」这类情形时，
  /// 把几种解释和各自还缺什么证据一起列出来，一条都不选。
  alternativesCiphertext  String?          @db.Text
  /// 反证搜索用过的关键词集合本身也是记忆正文的派生物，按同样的口径加密。
  counterTokensCiphertext String           @db.Text
  /// 反证命中了几条。0 也要留行：门槛 4 要的是「搜过反证」这件事有凭据，
  /// 而不只是「找到了反证」。
  counterHitCount         Int
  /// 时间范围按原样保留精度：模糊时间不许伪造成精确日期（7.4 门槛 6）。
  timeFrom                DateTime?
  timeTo                  DateTime?
  timePrecision           TimePrecision    @default(UNKNOWN)
  /// 样本数量与观察时间跨度（任务书 4.3、6.3）：数据不足时这两个数就是
  /// INSUFFICIENT_EVIDENCE 的判据本身，界面上也要把它们摊开给用户看。
  sampleCount             Int
  observationSpanDays     Int
  /// 置信度由 reflection-evidence 的 reflectionConfidence 按样本数、跨度与反证命中算出来再落库，
  /// 不接受任何口算数字。
  confidence              Float
  /// 重要程度：证据条数与时间跨度的档位分，只用于排序和「最多留 3 条」的取舍。
  importance              Float
  generatedAt             DateTime         @default(now())
  /// SNOOZED 到什么时候才允许重新摆到用户面前。
  snoozedUntil            DateTime?
  /// 过了这一刻，读侧把 PENDING 判成 EXPIRED（任务书 6.4 的最后一个状态）。
  expiresAt               DateTime?
  /// 用户做出动作（采纳/忽略/改/稍后）的时刻。
  decidedAt               DateTime?
  updatedAt               DateTime         @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations ReflectionCitation[]

  /// 给自己的引用行的复合外键用的：(洞察, 用户) 这一对唯一。
  @@unique([id, userId])
  @@unique([userId, dedupKey])
  @@index([userId, status])
  @@index([userId, generatedAt])
}

/// 一条反思引用的证据、站在支持还是反对的一侧（任务书 6.4 的主要证据 / 反对证据）。
///
/// 用连接表而不是把 id 串成一列写进正文列：这样跨用户引用在库层就建不出来，
/// 而且来源被永久删除时这条引用随行消失——Phase 7「删记忆要连带处理反思里的相关内容」
/// 就是这一条 cascade，读侧再按剩下几条引用判这条洞察还该不该留着。
///
/// 来源可以是记忆，也可以是决策：6.1 的 DECISION_LESSON 和「决策落定」那一类 MILESTONE
/// 的证据本来就是 DecisionRecord 那两行，硬把它们转写成记忆 id 就是造假。
/// **恰好一列非空**由服务层保证（写这一行的只有 reflection 生成那一条代码路径）：
/// Prisma 表达不了 CHECK，而在迁移里手写一条 CHECK 会让下一次 migrate diff 想把它删掉。
model ReflectionCitation {
  id           String                 @id @default(uuid())
  userId       String
  reflectionId String
  memoryId     String?
  decisionId   String?
  kind         ReflectionCitationKind
  createdAt    DateTime               @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reflection ReflectionRecord @relation(fields: [reflectionId, userId], references: [id, userId], onDelete: Cascade)
  memory     MemoryItem?      @relation("ReflectionCitationMemory", fields: [memoryId, userId], references: [id, userId], onDelete: Cascade)
  decision   DecisionRecord?  @relation("ReflectionCitationDecision", fields: [decisionId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([reflectionId, memoryId])
  @@unique([reflectionId, decisionId])
  @@index([userId, reflectionId])
  @@index([userId, memoryId])
  @@index([userId, decisionId])
}

/// 这一轮对话把哪几条记忆带进了提示词（任务书 7.1「记忆被再次调用时」）。
///
/// 一轮一行，不是一条记忆一行：注入上限是 8 条（memory-module.ts:44），
/// 一轮回一行就是一次写入，一轮记八列就得动 MemoryItem 那一行——而 `assessConfidence`
/// 读的正是那一行（supersededAt、validTo）。访问列和置信度的输入长在一张表上，
/// 「检索次数不能直接提高事实可信度」这条红线就从结构约束退化成一句自觉。
///
/// 这一行里只有 id，没有正文，抄 CognitiveTask 的口径（本文件那张表的注释）：
/// 「没有可以放正文的列」比「我们承诺不放正文」难违反得多。
///
/// 幂等靠库层 @@unique(sourceMessageId)：一条消息重发（重试、连点）不该记成两次访问，
/// 否则「最近 200 轮里被带到 3 次」里有一多半是重试。
///
/// memoryIds 是字符串数组，外键管不到它——所以「永久删除一条记忆」必须显式删掉引用过它的行
/// （src/lib/cognitive/forgetting.ts 的三条 purge 各删一次，测试是 cognitive-access.test.ts）。
/// chatId 故意只当普通列用（不建外键）：「忘记这次对话产生的记忆」不删会话，
/// 得按这一列把行收走；而会话真被删掉时，行会跟着 sourceMessage 那条外键一起走。
model MemoryAccessTurn {
  id              String   @id @default(uuid())
  userId          String
  sourceMessageId String
  memoryIds       String[]
  createdAt       DateTime @default(now())

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceMessage Message @relation("MemoryAccessTurnSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)

  @@unique([sourceMessageId])
  @@index([userId, createdAt])
}

/// 用户画像条目（任务书 8.2）。这张表里只存用户确认过的自我描述。
///
/// 「只存确认过的」在这里是结构，不是承诺，三处一起兜：
/// 一、`confirmedAt` 不可空，迁移也不给它 DEFAULT——值只能来自服务层写入那一刻的盖章；
/// 二、服务层的写入入参里根本没有这个字段（测试断的是 ProfileEntryInput 的形状），
///     所以「先存着，等以后确认」这种调用在类型层面就递不进去；
/// 三、没确认的候选只在纯函数层现算（profile-candidates.ts），永不落库，
///     所以这张表不需要「候选/已确认」那种状态列——有状态列就有默认值，有默认值就能绕过确认。
///
/// 正文跟记忆同等对待：密文，AAD 绑 `userId + 行 id + 字段名`。
/// 来源 id 是数组，外键管不到它，而且这里故意不管：那两个数组记的是「你确认时依据的是哪几条」，
/// 是一个时间戳式的事实。用户忘记某条记忆之后，这个来源不该被悄悄改写，也不该连带删掉画像条目
/// ——画像不是派生记录。解析不出来的 id 在界面上就是解析不出来，不谎报来源。
model UserProfileEntry {
  id                  String    @id @default(uuid())
  userId              String
  contentCiphertext   String    @db.Text
  sourceMemoryIds     String[]
  sourceReflectionIds String[]
  confirmedAt         DateTime
  /// 用户后来改过这句话的时刻。没改过就是 null——「改过」和「什么时候确认的」是两件不同的事。
  editedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, confirmedAt])
}

model CapabilityDimension {
  id String @id @default(uuid())
  userId String
  key String @db.VarChar(64)
  titleCiphertext String @db.Text
  goalCiphertext String? @db.Text
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidences CapabilityEvidence[]
  snapshots CapabilitySnapshot[]
  interventions InterventionRecord[]
  @@unique([id, userId])
  @@unique([userId, key])
  @@index([userId, enabled])
}
model CapabilityEvidence {
  id String @id @default(uuid())
  userId String
  dimensionId String
  sourceMessageId String?
  kind String @db.VarChar(24)
  score Float?
  noteCiphertext String @db.Text
  observedAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension CapabilityDimension @relation(fields: [dimensionId, userId], references: [id, userId], onDelete: Cascade)
  source Message? @relation("CapabilityEvidenceSource", fields: [sourceMessageId], references: [id], onDelete: Cascade)
  @@index([userId, dimensionId, observedAt])
  @@index([sourceMessageId])
}
model CapabilitySnapshot {
  id String @id @default(uuid())
  userId String
  dimensionId String
  estimate Float?
  confidence Float
  sampleCount Int
  trend Float?
  calculatedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension CapabilityDimension @relation(fields: [dimensionId, userId], references: [id, userId], onDelete: Cascade)
  @@index([userId, dimensionId, calculatedAt])
}
model InterventionRecord {
  id String @id @default(uuid())
  userId String
  dimensionId String
  suggestionCiphertext String @db.Text
  source String @db.VarChar(24)
  status String @default("PROPOSED") @db.VarChar(24)
  feedbackCiphertext String? @db.Text
  effectiveness Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension CapabilityDimension @relation(fields: [dimensionId, userId], references: [id, userId], onDelete: Cascade)
  experiences ExperienceNote[]
  @@unique([id, userId])
  @@index([userId, dimensionId, status])
}

model MemoryVerification {
  id         String @id @default(uuid())
  userId     String
  memoryId   String @unique
  status     String @default("UNVERIFIED") @db.VarChar(24)
  volatility String @default("MEDIUM") @db.VarChar(12)
  checkedAt  DateTime?
  expiresAt  DateTime?
  reviewer   String? @db.VarChar(24)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory MemoryItem @relation(fields: [memoryId, userId], references: [id, userId], onDelete: Cascade)
  // Prisma requires the complete composite foreign-key fields to be unique for a 1:1 relation.
  // memoryId is also unique on its own; the additional composite index retains strict user ownership.
  @@unique([memoryId, userId])
  @@index([userId, status, expiresAt])
}

model DreamingRun {
  userId String @id
  nextRunAt DateTime @default(now())
  lastRunAt DateTime?
  leaseUntil DateTime?
  leaseToken String? @db.VarChar(64)
  checkedCount Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([nextRunAt, leaseUntil])
}

model KnowledgePage {
  id String @id @default(uuid())
  userId String
  topicKey String @db.VarChar(64)
  titleCiphertext String @db.Text
  status String @default("DRAFT") @db.VarChar(16)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  citations KnowledgeCitation[]
  @@unique([id,userId])
  @@unique([userId,topicKey])
  @@index([userId,status])
}

model KnowledgeCitation {
  pageId String
  memoryId String
  userId String
  createdAt DateTime @default(now())
  page KnowledgePage @relation(fields: [pageId,userId], references: [id,userId], onDelete: Cascade)
  memory MemoryItem @relation(fields: [memoryId,userId], references: [id,userId], onDelete: Cascade)
  @@id([pageId,memoryId])
  @@index([userId,memoryId])
}

model ExperienceNote {
  id String @id @default(uuid())
  userId String
  sourceMemoryId String?
  sourceInterventionId String?
  titleCiphertext String @db.Text
  lessonCiphertext String @db.Text
  validationCiphertext String? @db.Text
  status String @default("DRAFT") @db.VarChar(16)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory MemoryItem? @relation(fields: [sourceMemoryId,userId], references: [id,userId], onDelete: Cascade)
  intervention InterventionRecord? @relation(fields: [sourceInterventionId,userId], references: [id,userId], onDelete: Cascade)
  @@index([userId,status,updatedAt])
  @@index([userId,sourceMemoryId])
  @@index([userId,sourceInterventionId])
}
