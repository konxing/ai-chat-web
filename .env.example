# ============================================================
# Family AI Chat — environment template
# Copy to .env and fill every CHANGE_ME value.
# NEVER commit .env, real keys, passwords or passphrases.
# ============================================================

NODE_ENV=production

# --- Core ---------------------------------------------------
DATABASE_URL=postgresql://family_chat:CHANGE_ME@127.0.0.1:5432/family_chat?schema=public
APP_URL=https://chat.example.com
HOST=127.0.0.1
PORT=3000

# 同一部署有多个入口时（局域网 IP、备用域名）把它们写在这里，逗号分隔。
# 跨站来源校验只认 APP_URL + 这份清单，不会认请求自带的 Host。
# ALLOWED_ORIGINS=http://192.168.1.5:3000,https://chat.example.com

# 32 random bytes, base64. Used for HMAC of e-mail codes.
# Generate: openssl rand -base64 32
APP_SECRET=CHANGE_ME_32_BYTES_BASE64

# --- Data encryption (AES-256-GCM) --------------------------
# Generate: openssl rand -base64 32
MASTER_KEY=CHANGE_ME_32_BYTES_BASE64
MASTER_KEY_ID=k1
# Optional keyring for rotation, JSON map {"k1":"<base64>","k2":"<base64>"}.
# Keep old keys here until `npm run rotate-keys` has completed.
MASTER_KEYRING=

# --- Cookies / proxy trust ----------------------------------
# Must be true in production (HTTPS). Set false only for local HTTP tests.
COOKIE_SECURE=true
# Only trust X-Real-IP when the TCP peer is in TRUSTED_PROXY_CIDRS.
TRUST_PROXY=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Whitelist cache refresh interval in milliseconds.
IP_CACHE_MS=1000

# --- E-mail (SMTP) ------------------------------------------
# smtp | console. "console" prints codes to the server log and is for
# first-run/local use only. "file" is a test sink and refuses to run in production.
EMAIL_TRANSPORT=console
EMAIL_FROM="Family AI <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
# If using EMAIL_TRANSPORT=file (tests only):
TEST_MAIL_DIR=./test-results/mail

# --- Storage -------------------------------------------------
UPLOAD_DIR=/srv/family-ai-chat/uploads
MAX_UPLOAD_MB=20
BACKUP_DIR=/srv/family-ai-chat/backups
# Number of newest .facbackup files npm run backup keeps (0 disables pruning).
BACKUP_KEEP=30
# Where rotate-keys writes the new master key before touching any data.
# Defaults to BACKUP_DIR/key-rotation.
# ROTATE_KEY_DIR=/srv/family-ai-chat/secrets/key-rotation

# Independent backup encryption passphrase. Store in a password manager.
# Generate: openssl rand -base64 24
BACKUP_PASSPHRASE=CHANGE_ME_BACKUP_PASSPHRASE

# --- AI / SSRF protection ------------------------------------
# MUST be false in production. True allows private/loopback provider URLs
# (needed for the local mock AI server during tests).
ALLOW_PRIVATE_AI_URLS=false

# --- Operations ----------------------------------------------
LOG_LEVEL=info
# Optional commands run after an admin IP change (see docs/IP_WHITELIST.md)
# NGINX_RELOAD_CMD="sudo /usr/sbin/nginx -s reload"
# NGINX_ALLOWLIST_PATH=/etc/nginx/family-ai-chat/ip-allow.conf
