# ============================================================
# Family AI Chat — Docker Compose environment template
# Copy to `.env` (chmod 600) and fill every CHANGE_ME value.
# NEVER commit .env or real secrets.
# ============================================================

# --- Compose / PostgreSQL -----------------------------------
# Use URL-safe characters (A-Z a-z 0-9 - _ .) because it is embedded in DATABASE_URL.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- Core ---------------------------------------------------
APP_URL=https://chat.example.com
APP_SECRET=CHANGE_ME_32_BYTES_BASE64

# --- Data encryption (AES-256-GCM) --------------------------
# Generate: openssl rand -base64 32
MASTER_KEY=CHANGE_ME_32_BYTES_BASE64
MASTER_KEY_ID=k1
# Keep old keys here only while rotating: {"k1":"<base64>","k2":"<base64>"}
MASTER_KEYRING=

# --- Network gate -------------------------------------------
TRUST_PROXY=true
# Compose overrides this to the static Nginx address; keep the subnet in sync.
TRUSTED_PROXY_CIDRS=172.28.0.10/32
IP_CACHE_MS=1000
# Docker uses Nginx auth_request for immediate updates; leave this empty.
NGINX_ALLOWLIST_PATH=
NGINX_RELOAD_CMD=

# --- E-mail -------------------------------------------------
# console prints verification codes to `docker compose logs app` (first run only).
# Switch to smtp before inviting family members.
EMAIL_TRANSPORT=console
EMAIL_FROM="Family AI <no-reply@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# --- Storage ------------------------------------------------
# Containers use /app/uploads and /app/backups; compose sets these itself.
MAX_UPLOAD_MB=20
BACKUP_PASSPHRASE=CHANGE_ME_BACKUP_PASSPHRASE

# --- AI / SSRF ----------------------------------------------
# MUST stay false. Provider URLs must be public HTTPS endpoints.
ALLOW_PRIVATE_AI_URLS=false

# --- Operations ---------------------------------------------
LOG_LEVEL=info
